{
  "name": "remote-claude",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/daemon",
    "packages/client",
    "packages/gui"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rcd": "tsx packages/daemon/src/cli.ts",
    "rc": "tsx packages/client/src/cli.ts",
    "gui": "npm --workspace @rc/gui run start",
    "gui:build": "npm --workspace @rc/gui run build",
    "test:gui": "npm run gui:build && tsx test/gui-e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
